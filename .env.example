# Copy to .env.local and fill in the secret values, then `npm run dev`.
# Pull the real DATABASE_URL / secrets from Railway (see LOCAL_DEV.md).
# .env.local is gitignored — never commit real secrets.

# --- Database -------------------------------------------------------------
# Shared STAGING Postgres (Railway). Use the public proxy URL
# (Railway -> Postgres service -> Variables -> DATABASE_PUBLIC_URL), not the
# internal postgres.railway.internal host. Local dev points here on purpose so
# testing is centralized rather than per-developer.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.proxy.rlwy.net:PORT/railway"

# --- Auth (better-auth) ---------------------------------------------------
# Generate: `npx auth secret` or `openssl rand -base64 32` (>= 32 chars).
BETTER_AUTH_SECRET="<32+ char random string>"
BETTER_AUTH_URL="http://localhost:3000"

# --- App URLs (local) -----------------------------------------------------
# Do NOT set NODE_ENV here — `next dev` forces development on its own.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEBAPP_URL="http://localhost:3000"

# Deployed staging backend (NestJS). Its CORS allows localhost:3000; the BFF
# proxy at app/api/be handles *.localhost tenant hosts.
NEXT_PUBLIC_BACKEND_URL="https://strive-core-development.up.railway.app"

# Required for proxy.ts to resolve a subdomain -> tenant UUID via the backend's
# /api/v1/meta/resolve endpoint. Pull from Railway backend service Variables.
INTERNAL_API_SECRET="<backend internal api secret>"

# --- Optional: Keycloak OAuth --------------------------------------------
# Leave unset for local dev (email/password works). Set all three to enable the
# Keycloak provider in lib/auth.ts.
# KEYCLOAK_CLIENT_ID=""
# KEYCLOAK_CLIENT_SECRET=""
# KEYCLOAK_ISSUER=""

# --- Optional: Google OAuth ----------------------------------------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
